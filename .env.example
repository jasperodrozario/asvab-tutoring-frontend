# Copy these blank entries into .env.local and fill them in.
# Firebase Console > Project settings > Your apps > Web app configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Console > Project settings > Service accounts.
# Server-only: never prefix these with NEXT_PUBLIC_.
FIREBASE_CLIENT_EMAIL=
# Keep the quotes; use \n for newlines in the private key.
FIREBASE_PRIVATE_KEY=""

# Existing PHP API/session settings: preserve your current values in .env.local.
NEXT_PUBLIC_PHP_API_URL=
INTERNAL_API_SECRET=
AUTH_SESSION_SECRET=
