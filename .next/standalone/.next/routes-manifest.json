  "dynamicRoutes": [
    {
      "page": "/blog-detail/[blog_id]",
      "regex": "^/blog\\-detail/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPblog_id": "nxtPblog_id"
      },
      "namedRegex": "^/blog\\-detail/(?<nxtPblog_id>[^/]+?)(?:/)?$"
    },
    {
      "page": "/course-detail/[courseCode]",
      "regex": "^/course\\-detail/([^/]+?)(?:/)?$",
